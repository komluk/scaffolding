{
 "version": 1,
 "source": "aiproxy presidio_recognizers.json",
 "patterns": [
  {
   "entity": "GITLAB_PAT",
   "name": "glpat",
   "regex": "glpat-[0-9a-zA-Z_\\-]{20,}(?:\\.[0-9a-zA-Z]+){0,2}"
  },
  {
   "entity": "LINEAR_API_KEY",
   "name": "lin_api",
   "regex": "lin_api_[0-9a-zA-Z]{40}"
  },
  {
   "entity": "ANTHROPIC_API_KEY",
   "name": "sk_ant",
   "regex": "sk-ant-[0-9a-zA-Z_\\-]{32,}"
  },
  {
   "entity": "VAULT_TOKEN",
   "name": "hvs_tok",
   "regex": "hvs\\.[0-9a-zA-Z]{24,}"
  },
  {
   "entity": "NPM_TOKEN",
   "name": "npm_tok",
   "regex": "npm_[0-9a-zA-Z]{36}"
  },
  {
   "entity": "GITEA_PAT",
   "name": "gitea_tok",
   "regex": "gitea_[0-9a-zA-Z]{40}"
  },
  {
   "entity": "CLOUDFLARE_TOKEN",
   "name": "cfut",
   "regex": "cfut_[0-9a-zA-Z]{40,}"
  },
  {
   "entity": "PROXMOX_TOKEN",
   "name": "pve_tok",
   "regex": "[a-zA-Z0-9_.:-]+@[a-zA-Z0-9_.:-]+![a-zA-Z0-9_.:-]+=[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
  },
  {
   "entity": "TAILSCALE_KEY",
   "name": "tskey",
   "regex": "tskey-(?:client|auth|api)-[0-9a-zA-Z_\\-]{20,}"
  },
  {
   "entity": "SK_PREFIXED_KEY",
   "name": "sk_key",
   "regex": "sk-[0-9a-zA-Z_\\-]{32,}"
  },
  {
   "entity": "AZURE_DEVOPS_PAT",
   "name": "azdo_pat",
   "regex": "[a-zA-Z0-9]{75}AZDO[a-zA-Z0-9]{5}"
  },
  {
   "entity": "AZURE_AD_SECRET",
   "name": "q_tilde",
   "regex": "[a-zA-Z0-9_~.\\-]{3}[0-9]Q~[a-zA-Z0-9_~.\\-]{31,34}"
  },
  {
   "entity": "AZURE_SAS_TOKEN",
   "name": "sas_sig",
   "regex": "sig=[A-Za-z0-9+/%]{43,73}(?:=|%3[Dd])"
  },
  {
   "entity": "STORAGE_KEY_B64",
   "name": "b64_86",
   "regex": "[A-Za-z0-9+/]{86}=="
  },
  {
   "entity": "NUGET_API_KEY",
   "name": "oy2",
   "regex": "oy2[a-zA-Z0-9]{43}"
  },
  {
   "entity": "PEM_PRIVATE_KEY",
   "name": "pem_key_full",
   "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\\s\\S]{0,20000}?-----END [A-Z0-9 ]*PRIVATE KEY-----"
  },
  {
   "entity": "PEM_PRIVATE_KEY",
   "name": "pem_key_dangling_header",
   "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[A-Za-z0-9+/=\\r\\n\\\\ ]{0,20000}"
  },
  {
   "entity": "PEM_PRIVATE_KEY",
   "name": "pem_key_dangling_footer",
   "regex": "[A-Za-z0-9+/=\\r\\n\\\\ ]{0,20000}-----END [A-Z0-9 ]*PRIVATE KEY-----"
  },
  {
   "entity": "GITHUB_TOKEN",
   "name": "ghp",
   "regex": "gh[psoura]_[A-Za-z0-9_]{36,}"
  },
  {
   "entity": "AWS_ACCESS_KEY",
   "name": "akia",
   "regex": "AKIA[0-9A-Z]{16}"
  },
  {
   "entity": "SLACK_TOKEN",
   "name": "xox",
   "regex": "xox[bparo]-[0-9A-Za-z\\-]{10,}"
  },
  {
   "entity": "PL_PESEL",
   "name": "pesel",
   "regex": "(?<![\\w-])(?<!\\d[.,])\\d{2}(?:0[1-9]|1[0-2]|2[1-9]|3[0-2]|4[1-9]|5[0-2]|6[1-9]|7[0-2]|8[1-9]|9[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{5}(?![\\w-])(?![.,]\\d)"
  },
  {
   "entity": "IBAN_SPACED",
   "name": "iban_spaced",
   "regex": "(?<![\\w-])(?<!\\d[.,])(?>[A-Z]{2}\\d{2}(?:(?: [A-Z0-9]{4}){7}(?: (?=[A-Z0-9]*\\d)[A-Z0-9]{1,2})?|(?: [A-Z0-9]{4}){3,6}(?: (?=[A-Z0-9]*\\d)[A-Z0-9]{1,4})?|(?: [A-Z0-9]{4}){2} (?=[A-Z0-9]*\\d)[A-Z0-9]{3,4}))(?![\\w-])(?![.,]\\d)"
  },
  {
   "entity": "PL_BANK_ACCOUNT",
   "name": "pl_nrb_grouped",
   "regex": "(?<![\\w-])(?<!\\d[ .,])(?:PL[ ]?)?\\d{2}(?: \\d{4}){6}(?![\\w-])(?![.,]\\d)"
  },
  {
   "entity": "PL_BANK_ACCOUNT",
   "name": "pl_nrb_compact",
   "regex": "(?<![\\w-])(?<!\\d[.,])(?:PL)?\\d{26}(?![\\w-])(?![.,]\\d)"
  }
 ]
}
