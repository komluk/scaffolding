#!/usr/bin/env bash
# pre-commit-validation-copilot.sh — Copilot-shaped wrapper around the
# scaffolding plugin's framework-agnostic pre-commit validator.
#
# Generated by scaffolding-sync.sh — DO NOT EDIT BY HAND, re-run
# ~/.copilot/scaffolding-sync.sh instead (it renders this file from the
# .tmpl next to it).
#
# Registered (design D2, post-Task-0 authoritative shape — V15-V18) as a
# PascalCase "PreToolUse" hook with matcher "Bash" inside the target repo's
# OWN .claude/settings.json (the only path proven to fire under copilot
# 1.0.77 — see design.md V15). Payload is snake_case, identical to Claude
# Code's own hook contract, but this script tolerates both casings
# defensively (design D2 dual-casing tolerance).
#
# Exit-code contract (design D2, updated post-Task-0): 0 = allow, 2 = block.
# This file is read by BOTH Copilot (V17: exit 2 -> "Denied by preToolUse
# hook: hook exited with code 2") and real Claude Code sessions in the same
# repo (exit 2 is Claude Code's own native block signal) — one contract,
# correct under both runtimes, no runtime-detection branch needed.
#
# Fail-open on ANY infrastructure error (missing node, unresolvable plugin
# root, empty/unparseable stdin): exit 0. A broken hook must never make
# committing impossible. Fail-closed ONLY on a real non-zero validator exit.

set -u

FAST_PATH_ROOT="__SCAFFOLDING_PLUGIN_ROOT_FASTPATH__"

fail_open() {
  echo "WARNING: pre-commit-validation-copilot: $1 -- allowing (fail-open)" >&2
  exit 0
}

block() {
  local reason="$1"
  echo "BLOCKED: pre-commit-validation-copilot: $reason" >&2
  printf '{"permissionDecision":"block","permissionDecisionReason":%s}\n' "$(printf '%s' "$reason" | node -e 'process.stdout.write(JSON.stringify(require("fs").readFileSync(0, "utf8")))' 2>/dev/null || printf '"%s"' "$reason")"
  exit 2
}

command -v node >/dev/null 2>&1 || fail_open "node not found on PATH"

payload="$(cat)"
[ -n "$payload" ] || fail_open "empty stdin payload"

# Payload fields, one per line: toolName, command, cwd. Backslashes and newlines inside a value are written as \\ and \n so
# every field stays on one line (decoded again with printf %b below). Exits 3 when the payload is not JSON: fail open.
# `cmd` is the first non-empty of toolInput.command, tool_input.command, toolInput.cmd, then the JSON text of toolInput
# (a command in any other shape still gets scanned for `git commit`).
fields=$(printf '%s' "$payload" | node -e '
  // Same answers as the jq program this replaced: `jq -e .` rejects null / false; `.toolInput.command` is an error (so an
  // empty command, which allows) when toolInput / tool_input is a string, number, boolean or array; `// empty` skips null and false.
  let p;
  try { p = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch { process.exit(3); }
  if (p === null || p === false) process.exit(3);
  const isObj = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
  const root = isObj(p) ? p : {};
  const raw = (v) => (v === undefined || v === null || v === false ? "" : typeof v === "string" ? v : JSON.stringify(v));
  const str = (v) => (v === undefined || v === null || v === "" ? "" : typeof v === "string" ? v : JSON.stringify(v));
  const ti = root.toolInput;
  const ti2 = root.tool_input;
  const unindexable = (v) => v !== undefined && v !== null && !isObj(v);
  const cands = [isObj(ti) ? ti.command : undefined, isObj(ti2) ? ti2.command : undefined, isObj(ti) ? ti.cmd : undefined, ti === undefined ? undefined : typeof ti === "string" ? ti : JSON.stringify(ti)];
  const cmd = unindexable(ti) || unindexable(ti2) ? "" : cands.map(str).find((v) => v !== "" && v !== "null") ?? "";
  const tool = raw([root.toolName, root.tool_name].find((v) => v !== undefined && v !== null && v !== false));
  process.stdout.write([tool, cmd, raw(root.cwd)].map((v) => String(v).replace(/\\/g, "\\\\").replace(/\n/g, "\\n")).join("\n"));
' 2>/dev/null) || fail_open "unparseable JSON payload"

unescape() { printf '%b' "$(printf '%s\n' "$fields" | sed -n "${1}p")"; }
tool=$(unescape 1)
cmd=$(unescape 2)
payload_cwd=$(unescape 3)

# Self-filter 1: only shell-like tools are of interest. matcher: "Bash" in
# the registration already narrows this, but the script self-filters
# regardless (design D2 rationale: matcher cannot express the command-level
# git-commit condition, so filtering must happen here either way).
if ! echo "$tool" | grep -qiE '^(bash|shell|run.*|execute.*)$'; then
  exit 0
fi

# Self-filter 2: only a `git commit` invocation blocks. Matches `git commit`,
# `git -C /x commit` (flag + its value token), `foo && git commit`; does not
# match `git log --grep commit`.
#
# NOTE: design.md's D2 regex `(^|[;&|[:space:]])git([[:space:]]+-[^[:space:]]+)*
# [[:space:]]+commit([[:space:]]|$)` does not actually match `git -C /x commit`
# despite the design prose claiming it does -- `-C`'s value token `/x` doesn't
# start with `-`, so the design's flags-only group can't consume it. This is
# the same regex extended with an optional non-flag value token after each
# flag, so it matches all three of the design's own worked examples.
commit_re='(^|[;&|[:space:]])git([[:space:]]+-[^[:space:]]+([[:space:]]+[^[:space:]-][^[:space:]]*)?)*[[:space:]]+commit([[:space:]]|$)'
if ! echo "$cmd" | grep -qE "$commit_re"; then
  exit 0
fi

# Locate the upstream validator: the shared three-tier resolver is the
# primary source (dynamic — honours a live $SCAFFOLDING_PLUGIN_ROOT override
# and a manifest that moved since the last sync); the sync-baked absolute
# path is only a fallback for when the resolver script itself is missing or
# fails outright (design D2: "one implementation, one behaviour, both
# upgrade-safe" — the fast path must not silently shadow the resolver's
# override tier, or a test/debug SCAFFOLDING_PLUGIN_ROOT would be ignored).
VALIDATOR=""
RESOLVER="$HOME/.copilot/scaffolding-plugin-root.sh"
if [ -f "$RESOLVER" ]; then
  # shellcheck source=/dev/null
  source "$RESOLVER"
  if root=$(resolve_plugin_root 2>/dev/null); then
    VALIDATOR="$root/hooks/pre-commit-validation.sh"
  fi
fi
if [ -z "$VALIDATOR" ] && [ -n "$FAST_PATH_ROOT" ] && [ -f "$FAST_PATH_ROOT/hooks/pre-commit-validation.sh" ]; then
  VALIDATOR="$FAST_PATH_ROOT/hooks/pre-commit-validation.sh"
fi

[ -n "$VALIDATOR" ] && [ -f "$VALIDATOR" ] || fail_open "could not resolve pre-commit-validation.sh"

# Resolve the dir the commit actually targets: the hook process's own cwd is
# the session start dir, not necessarily the repo being committed to. The
# validator probes ./Makefile, ./package.json, etc. relative to its cwd, so
# run it there. Priority: 1. `git -C <dir>`  2. last `cd <dir> &&|;` before
# the commit  3. payload .cwd  4. $PWD. Relative dirs resolve against 3/4.
strip_dir() { # strip surrounding quotes, expand leading ~
  local d="$1"
  case "$d" in
    \"*\"|\'*\') d="${d:1:${#d}-2}" ;;
  esac
  case "$d" in
    \~) d="$HOME" ;;
    \~/*) d="$HOME/${d#\~/}" ;;
  esac
  printf '%s' "$d"
}

base="$payload_cwd"
[ -n "$base" ] || base="$PWD"
target="$base"
re_val='("[^"]*"|'"'"'[^'"'"']*'"'"'|[^[:space:]]+)'
re_c='^.*[[:space:]]-C[[:space:]]+'"$re_val"
re_cd='^(.*[;&|(`[:space:]])?cd[[:space:]]+'"$re_val"'[[:space:]]*(&&|;)'
inv=$(echo "$cmd" | grep -oE "$commit_re" | head -1)
prefix="${cmd%%"$inv"*}"
if [[ $inv =~ $re_c ]]; then
  target=$(strip_dir "${BASH_REMATCH[1]}")
elif [[ $prefix =~ $re_cd ]]; then
  target=$(strip_dir "${BASH_REMATCH[2]}")
fi
case "$target" in /*) ;; *) target="$base/$target" ;; esac
[ -d "$target" ] || fail_open "target dir does not exist: $target"

# Run the upstream validator UNMODIFIED, in the target dir.
(cd "$target" && bash "$VALIDATOR")
rc=$?

case "$rc" in
  0) exit 0 ;;
  1) block "validation failed (exit 1)" ;;
  2) block "validation failed (exit 2)" ;;
  *) block "validator exited with unexpected status $rc" ;;
esac
